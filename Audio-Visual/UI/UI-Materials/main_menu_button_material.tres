code = "shader_type canvas_item;
render_mode blend_add;

uniform vec2 UV_Adjust = vec2(1.000000, 1.000000);
uniform sampler2D Pattern : hint_default_transparent, filter_linear, repeat_enable;
uniform float Pattern_Opacity = 0.40000000596046;



void fragment() {
// Input:3
	vec2 n_out3p0 = SCREEN_UV;


// FloatConstant:12
	float n_out12p0 = 20.000000;


// VectorOp:5
	vec2 n_out5p0 = n_out3p0 * vec2(n_out12p0);


// Vector2Parameter:15
	vec2 n_out15p0 = UV_Adjust;


// VectorOp:14
	vec2 n_out14p0 = n_out5p0 * n_out15p0;


// Input:4
	float n_out4p0 = TIME;


// FloatOp:8
	float n_in8p1 = 0.50000;
	float n_out8p0 = n_out4p0 * n_in8p1;


// VectorOp:7
	vec2 n_out7p0 = n_out14p0 + vec2(n_out8p0);


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(Pattern, n_out7p0);


// ColorConstant:13
	vec4 n_out13p0 = vec4(1.000000, 1.000000, 1.000000, 1.000000);


// ColorOp:9
	vec3 n_out9p0 = min(vec3(n_out2p0.xyz), vec3(n_out13p0.xyz));


// VectorDecompose:11
	float n_out11p0 = n_out2p0.x;
	float n_out11p1 = n_out2p0.y;
	float n_out11p2 = n_out2p0.z;
	float n_out11p3 = n_out2p0.w;


// FloatParameter:17
	float n_out17p0 = Pattern_Opacity;


// FloatOp:16
	float n_out16p0 = n_out11p3 * n_out17p0;


// Output:0
	COLOR.rgb = n_out9p0;
	COLOR.a = n_out16p0;


}
