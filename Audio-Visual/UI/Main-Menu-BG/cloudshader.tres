code = "shader_type canvas_item;
render_mode blend_add;

uniform sampler2D cloud : hint_default_transparent, repeat_enable;
uniform float opacity : hint_range(0.0, 1.0) = 1.0;



void fragment() {
// Input:3
	vec2 n_out3p0 = UV;


// Input:6
	float n_out6p0 = TIME;


// FloatOp:7
	float n_in7p1 = 0.10000;
	float n_out7p0 = n_out6p0 * n_in7p1;


// VectorCompose:5
	float n_in5p1 = 0.00000;
	vec2 n_out5p0 = vec2(n_out7p0, n_in5p1);


// VectorOp:4
	vec2 n_out4p0 = n_out3p0 + n_out5p0;


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(cloud, n_out4p0);


// FloatParameter:9
	float n_out9p0 = opacity;


// Output:0
	COLOR.rgb = vec3(n_out2p0.xyz);
	COLOR.a = n_out9p0;


}
"
