code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D grass_texture : hint_default_transparent, repeat_disable;



void fragment() {
// Input:4
	vec2 n_out4p0 = UV;


// Input:7
	float n_out7p0 = TIME;


// FloatOp:8
	float n_in8p1 = 0.50000;
	float n_out8p0 = n_out7p0 * n_in8p1;


// FloatFunc:9
	float n_out9p0 = cos(n_out8p0);


// FloatOp:10
	float n_in10p1 = 0.30000;
	float n_out10p0 = n_out9p0 * n_in10p1;


// VectorDecompose:13
	float n_out13p0 = n_out4p0.x;
	float n_out13p1 = n_out4p0.y;


// FloatOp:14
	float n_in14p0 = 1.00000;
	float n_out14p0 = n_in14p0 - n_out13p1;


// FloatOp:12
	float n_out12p0 = n_out10p0 * n_out14p0;


// FloatOp:15
	float n_in15p1 = -0.15000;
	float n_out15p0 = n_out12p0 + n_in15p1;


// VectorCompose:11
	float n_in11p1 = 0.00000;
	vec2 n_out11p0 = vec2(n_out15p0, n_in11p1);


// VectorOp:5
	vec2 n_out5p0 = n_out4p0 + n_out11p0;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(grass_texture, n_out5p0);


// VectorDecompose:6
	float n_out6p0 = n_out3p0.x;
	float n_out6p1 = n_out3p0.y;
	float n_out6p2 = n_out3p0.z;
	float n_out6p3 = n_out3p0.w;


// Output:0
	COLOR.rgb = vec3(n_out3p0.xyz);
	COLOR.a = n_out6p3;


}
